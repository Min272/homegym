<?xml version="1.0" encoding="utf-8"?>
<!-- Widget vịt: nền trong suốt, chỉ có con vịt (4 khung lật liên tục thành hoạt ảnh). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plant_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ViewFlipper
        android:id="@+id/duck_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="1050">

        <ImageView
            android:id="@+id/duck0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_name"
            android:scaleType="fitCenter"
            android:src="@drawable/duck_fit_0" />
        <ImageView
            android:id="@+id/duck1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_name"
            android:scaleType="fitCenter"
            android:src="@drawable/duck_fit_1" />
        <ImageView
            android:id="@+id/duck2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_name"
            android:scaleType="fitCenter"
            android:src="@drawable/duck_fit_2" />
        <ImageView
            android:id="@+id/duck3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_name"
            android:scaleType="fitCenter"
            android:src="@drawable/duck_fit_3" />
    </ViewFlipper>
</FrameLayout>
